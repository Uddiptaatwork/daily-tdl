# Example only: server.py reads environment variables, not .env files.
# Export these values in your shell or service configuration. Never commit credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@example.com
# For implicit TLS use SMTP_SECURITY=ssl and usually SMTP_PORT=465.
